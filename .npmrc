# Supply-chain hardening. See docs/supply-chain.md before changing anything here.

# Refuse versions published less than 7 days ago. A malicious release from a hijacked maintainer
# account is usually caught and unpublished within that window, so waiting it out keeps it out
# of the install. `npm ci` does not apply this rule; the lockfile is what guards a clean install.
min-release-age=7

# A dependency's lifecycle hooks (preinstall, install, postinstall) run during installation, before
# any app code, and can steal credentials from a package that is never imported. They stay off,
# and the one script this project needs runs explicitly via `npm run native:fetch`.
ignore-scripts=true

# Saved dependencies keep a range prefix, which is npm's default. The lockfile pins the exact
# version that installs.
save-exact=false
