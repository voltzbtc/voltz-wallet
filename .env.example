# Copy to .env and fill in. The values are compiled into the JavaScript bundle by
# react-native-dotenv, and src/config.ts is the only module that reads them. After editing .env,
# restart Metro with `npm start -- --reset-cache` so the new values are picked up.

# Breez SDK Spark API key, required to connect. Request one at
# https://breez.technology/request-api-key/
BREEZ_SPARK_API_KEY=

# Domain that serves the wallets' lightning addresses (name@domain) and the app's gateway under /api.
# It has to run a Breez-compatible LNURL server; docs/trust-model.md describes both services. Leave
# it empty to keep addresses on the SDK's default LNURL server with no server side of the project
# involved, in which case push registration is skipped. Moving one wallet's addresses to a domain of
# its own is covered in docs/custom-domain.md.
BREEZ_LNURL_DOMAIN=

# How names and domain years are sold. Unset sells through the App Store or Google Play; 'direct'
# sells in sats, and holds only in a debug build.
VOLTZ_DISTRIBUTION=
